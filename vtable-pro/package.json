{
  "name": "vtable-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VTablePro —— 基于 @visactor/vtable 的可复用虚拟滚动表格组件（10 万行 / 非响应式全量导入 / 列级自定义组件 / 表头列筛选 / 工具栏勾选）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview --port 5278",
    "probe": "node tools/probe.mjs",
    "bench": "node tools/bench.mjs",
    "scale": "node tools/scale.mjs"
  },
  "dependencies": {
    "@visactor/vtable": "1.26.8",
    "@visactor/vue-vtable": "file:../_research/visactor-vue-vtable-1.26.8.tgz",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.20",
    "vue-tsc": "^2.1.10"
  }
}
